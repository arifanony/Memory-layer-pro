NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
# Verified NVIDIA option: nvidia/nemotron-3.5-lightning-30b-a3b
# Pick the provider this app should call: nvidia or openrouter.
# Leave empty to auto-select (OpenRouter when only its key is set).
LLM_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# Nemotron Ultra options (OpenRouter):
# nvidia/llama-3.1-nemotron-ultra-253b-v1:free (free tier, default when empty)
# nvidia/llama-3.1-nemotron-ultra-253b-v1 (paid)
# Recommended NVIDIA-direct chain (same endpoint, comma-separated, ≤2):
# LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-nano-30b-a3b
# Fallbacks run only when no model response was obtained (connection,
# rate-limit, unavailable model). Malformed output is reported, never retried.
LLM_FALLBACK_MODELS=
DATABASE_URL=postgresql://user:password@localhost:5432/memory_lab
REDIS_URL=redis://localhost:6379/0
EMBEDDING_MODEL=
TOP_K=3
REDIS_TTL_SECONDS=3600
